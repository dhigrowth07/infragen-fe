# ==========================================
# InfraGen Frontend Environment Variables
# ==========================================

# Application Port and Host
PORT=3000
NODE_ENV=production
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=https://staging-api.vizhiinfragenrealtor.com/api/v1

# Public Website URL
NEXT_PUBLIC_SITE_URL=https://staging.vizhiinfragenrealtor.com

# Default Currency & Localization
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_CITY=Coimbatore
NEXT_PUBLIC_DEFAULT_STATE=Tamil Nadu

# Google Gemini API Key (used for Vizhi AI Chatbot)
GEMINI_API_KEY=your_google_gemini_api_key_here
